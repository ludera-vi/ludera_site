# ─── Django ───────────────────────────────────────────────
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# ─── Database ─────────────────────────────────────────────
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# PostgreSQL (для продакшна)
# DB_ENGINE=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ─── Email (SMTP) ─────────────────────────────────────────
EMAIL_BACKEND=console
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=your-email@yandex.ru
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=your-email@yandex.ru
# OWNER_EMAIL=your-email@yandex.ru

# ─── OAuth ────────────────────────────────────────────────
YANDEX_CLIENT_ID=
YANDEX_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

